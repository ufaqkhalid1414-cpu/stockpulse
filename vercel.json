{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/scheduled-messages",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/monthly-chart",
      "schedule": "5 18 28-31 * *"
    },
    {
      "path": "/api/cron/daily-backup",
      "schedule": "15 2 * * *"
    }
  ]
}
