# Database — Firestore
DATABASE_BACKEND=firestore
FIREBASE_PROJECT_ID=stockpulse-597a6
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Or load all three from a service account JSON (do not commit the JSON):
# node scripts/load-firebase-env.mjs "D:\\secrets\\your-adminsdk.json"

# Optional: Vercel Blob for backup JSON files
BLOB_READ_WRITE_TOKEN=

# WhatsApp / Twilio (existing)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=
OTP_DEV_MODE=1
