# Copy to .env.local and fill in when you have Twilio / OpenAI keys.

# Public URL Twilio can reach (ngrok or your deployed host). Needed for weekly chart media.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Twilio WhatsApp Sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Example sandbox sender: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=

# Optional — voice-note transcription for WhatsApp Q&A
OPENAI_API_KEY=
