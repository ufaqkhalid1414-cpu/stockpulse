# Copy to .env.local (local) or set in Vercel Project Settings (production).
# Never commit real secrets.

# Public URL Twilio can reach. On Vercel set this to your production URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Twilio WhatsApp Sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Example sandbox sender: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=

# Optional — voice-note transcription for WhatsApp Q&A
OPENAI_API_KEY=

# Optional — show OTP on screen when Twilio is missing (local / staging only). Never enable in real pilot production.
OTP_DEV_MODE=1

# Optional but recommended on Vercel — durable SQLite + chart storage via Blob
# Created automatically when you add a Blob store in the Vercel dashboard.
BLOB_READ_WRITE_TOKEN=
