# Preferred persistent DB (Turso / libSQL). When set, StockPulse uses Turso instead of a local file.
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=

# Vercel Blob — used for (1) daily JSON backups and (2) durable local-SQLite flush on Vercel when Turso is not set
BLOB_READ_WRITE_TOKEN=

# Cron auth for /api/cron/*
CRON_SECRET=

# Local WhatsApp OTP testing without Twilio
OTP_DEV_MODE=1
